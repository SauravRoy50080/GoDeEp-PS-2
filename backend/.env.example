# Copy to backend/.env; never commit real credentials.
GODEEP_APP_NAME=GoDeEp API
GODEEP_ENVIRONMENT=development
# JSON arrays; use explicit deployed hostnames and exact frontend origins.
GODEEP_ALLOWED_HOSTS=["localhost","127.0.0.1"]
GODEEP_CORS_ORIGINS=[]
GODEEP_MAX_JSON_REQUEST_BYTES=262144
# Documentation defaults off in production; omit to retain environment defaults.
# GODEEP_DOCS_ENABLED=false
# Set a real local database URL before applying migrations.
GODEEP_DATABASE_URL=postgresql+psycopg://godeep:CHANGE_ME@127.0.0.1:5432/godeep
# Default evidence directory: backend/data/evidence (ignored by Git).
GODEEP_MAX_UPLOAD_BYTES=209715200

# Opaque bearer sessions and per-account failed-login lockout.
GODEEP_SESSION_TTL_SECONDS=28800
GODEEP_LOGIN_MAX_ATTEMPTS=5
GODEEP_LOGIN_LOCK_SECONDS=900

# Separate analysis worker: bounded archive and Android static evidence.
GODEEP_JOB_TIMEOUT_SECONDS=60
GODEEP_WORKER_POLL_SECONDS=2
GODEEP_MAX_RESULT_BYTES=1048576

# Manifest/certificate limits; byte counts except node/certificate counts.
GODEEP_MAX_MANIFEST_BYTES=2097152
GODEEP_MAX_MANIFEST_NODES=20000
GODEEP_MAX_SIGNATURE_BYTES=8388608
GODEEP_MAX_CERTIFICATE_MEMBER_BYTES=1048576
GODEEP_MAX_CERTIFICATES=64

# DEX identifier-table triage bounds.
GODEEP_MAX_DEX_BYTES=16777216
GODEEP_MAX_DEX_TOTAL_BYTES=67108864
GODEEP_MAX_DEX_FILES=32
GODEEP_MAX_DEX_IDENTIFIERS=100000
GODEEP_MAX_DEX_STRING_BYTES=8192
GODEEP_MAX_DEX_FINDINGS=500

# Per-member instruction-analysis bounds.
GODEEP_MAX_DEX_ENCODED_METHODS=10000
GODEEP_MAX_DEX_CODE_UNITS=1000000

# Unified review grouping and evidence caps.
GODEEP_MAX_REVIEW_FINDINGS=500
GODEEP_MAX_REVIEW_EVIDENCE=50

# Optional Windows official apksigner verification (external tools, not pip packages).
# Absolute java.exe and apksigner.jar paths; record the JAR SHA-256 after trusted installation.
# GODEEP_SIGNER_JAVA_PATH=C:/path/to/jdk/bin/java.exe
# GODEEP_SIGNER_JAR_PATH=C:/path/to/Android/Sdk/build-tools/35.0.0/lib/apksigner.jar
# GODEEP_SIGNER_JAR_SHA256=REPLACE_WITH_64_LOWERCASE_HEX_DIGEST
GODEEP_SIGNER_TIMEOUT_SECONDS=20
GODEEP_MAX_SIGNER_OUTPUT_BYTES=65536

# Resource/library-metadata inventory bounds.
GODEEP_MAX_RESOURCE_FILES=128
GODEEP_MAX_RESOURCE_BYTES=1048576
GODEEP_MAX_RESOURCE_TOTAL_BYTES=16777216
GODEEP_MAX_RESOURCE_NODES=2000
GODEEP_MAX_RESOURCE_FINDINGS=500

# Optional pinned offline threat feed (private operator configuration).
# GODEEP_INTEL_FEED_PATH=C:/path/to/private/feed.json
# GODEEP_INTEL_FEED_SHA256=REPLACE_WITH_64_LOWERCASE_HEX_DIGEST
GODEEP_INTEL_MAX_FEED_AGE_DAYS=30
GODEEP_MAX_INTEL_FEED_BYTES=2097152
GODEEP_MAX_INTEL_CANDIDATES=1000
GODEEP_MAX_INTEL_MATCHES=50

# Maximum persisted forensic JSON report size (10 MiB).
GODEEP_MAX_REPORT_BYTES=10485760
# HTML can grow when source text is escaped; fail rather than truncate.
GODEEP_MAX_REPORT_HTML_BYTES=67108864

# Read-only comparison limits: differences per category and total response bytes.
GODEEP_MAX_COMPARISON_ITEMS=200
GODEEP_MAX_COMPARISON_BYTES=2097152

# Maximum imported structured runtime trace request bytes (2 MiB).
GODEEP_MAX_RUNTIME_CAPTURE_BYTES=2097152

# Runtime timeline combined source and response bounds.
GODEEP_MAX_TIMELINE_SOURCE_BYTES=10485760
GODEEP_MAX_TIMELINE_BYTES=1048576

# Optional pinned offline exact-version Maven advisory feed.
# GODEEP_LIBRARY_FEED_PATH=C:/private-feeds/libraries.json
# GODEEP_LIBRARY_FEED_SHA256=REPLACE_WITH_64_LOWERCASE_HEX_DIGEST
GODEEP_LIBRARY_FEED_MAX_AGE_DAYS=30
GODEEP_MAX_LIBRARY_FEED_BYTES=2097152
GODEEP_MAX_LIBRARY_MATCHES=20

# APK-wide retained invoke-graph budgets.
GODEEP_MAX_GRAPH_EDGES=1000
GODEEP_MAX_GRAPH_NODES=2000

# Read-only static/runtime IP correlation views
GODEEP_MAX_NETWORK_CORRELATION_GROUPS=5000
GODEEP_MAX_NETWORK_CORRELATION_CANDIDATES=20000
GODEEP_MAX_NETWORK_CORRELATION_EVIDENCE=25
GODEEP_MAX_NETWORK_CORRELATION_BYTES=1048576

# Bounded intraprocedural normal flow (APK-wide caps except method units)
GODEEP_MAX_CFG_METHODS=100
GODEEP_MAX_CFG_BLOCKS=2000
GODEEP_MAX_CFG_EDGES=4000
GODEEP_MAX_CFG_CODE_UNITS=20000

# Read-only runtime report inventories, comparisons and printable pages.
GODEEP_MAX_RUNTIME_REVIEW_EVENTS=40000
GODEEP_MAX_RUNTIME_REVIEW_GROUPS=2000
GODEEP_MAX_RUNTIME_REVIEW_EVIDENCE=5
GODEEP_MAX_RUNTIME_REVIEW_BYTES=2097152
GODEEP_MAX_RUNTIME_REVIEW_HTML_BYTES=16777216

# Optional dex_exception_flow adapter; retained APK-wide counts and per-method bytes.
GODEEP_MAX_EXCEPTION_TRIES=256
GODEEP_MAX_EXCEPTION_HANDLERS=512
GODEEP_MAX_EXCEPTION_CATCHES=1024
GODEEP_MAX_EXCEPTION_TABLE_BYTES=32768

# Append-only analyst review history, reference hashing and export bounds.
GODEEP_MAX_REPORT_REVIEW_ENTRIES=500
GODEEP_MAX_REPORT_REVIEW_REFERENCE_BYTES=16777216
GODEEP_MAX_REPORT_REVIEW_BYTES=4194304
GODEEP_MAX_REPORT_REVIEW_HTML_BYTES=16777216
