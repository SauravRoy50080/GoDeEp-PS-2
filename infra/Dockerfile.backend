FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY requirements.txt ./
COPY backend ./backend
RUN pip install -r requirements.txt && pip check \
    && groupadd --gid 10001 godeep \
    && useradd --uid 10001 --gid 10001 --no-create-home godeep \
    && mkdir -p /var/lib/godeep/evidence \
    && chown -R 10001:10001 /var/lib/godeep
USER 10001:10001
CMD ["python","-m","uvicorn","godeep.main:app","--host","0.0.0.0","--port","8000","--no-proxy-headers"]
